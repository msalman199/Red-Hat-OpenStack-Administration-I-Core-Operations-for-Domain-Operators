        <version>3.20.0</version>
    </dependency>
</dependencies>
Step 3: Configure Transaction Manager
Create a application.properties file in src/main/resources:
# PostgreSQL Configuration
spring.datasource.url=jdbc:postgresql://localhost:5432/testdb
spring.datasource.username=postgres
spring.datasource.password=password
spring.datasource.driver-class-name=org.postgresql.Driver

# Atomikos (JTA) Configuration
spring.jta.enabled=true
spring.jta.log-dir=target/transaction-logs
Lab Tasks
Task 1: Define and Implement Distributed Transactions
Step 1: Create a Camel Route with Transaction Support
Create a new Java class TransactionRoute.java:
import org.apache.camel.builder.RouteBuilder;
import org.springframework.stereotype.Component;

@Component
public class TransactionRoute extends RouteBuilder {
    @Override
    public void configure() throws Exception {
        from("direct:start")
            .transacted()  // Enable transaction support
            .log("Inserting data into database...")
            .to("sql:INSERT INTO orders (id, product, amount) VALUES (1, 'Laptop', 1000)")
            .log("Data inserted successfully.");
    }
}
Expected Outcome:
A Camel route is configured to execute a database transaction.
Troubleshooting:
If you encounter errors, ensure:
The database is running.
The application.properties file has correct credentials.
Task 2: Use XA Transactions for Multiple Resource Management
Step 1: Configure XA Transaction Manager
Modify application.properties to include XA datasource:
# XA Datasource Configuration
spring.jta.atomikos.datasource.xa-data-source-class-name=org.postgresql.xa.PGXADataSource
spring.jta.atomikos.datasource.xa-properties.url=jdbc:postgresql://localhost:5432/testdb
spring.jta.atomikos.datasource.xa-properties.user=postgres
spring.jta.atomikos.datasource.xa-properties.password=password
Step 2: Update Route to Use XA Resources
Extend the TransactionRoute to include JMS (ActiveMQ) as a second resource:
from("direct:xaTransaction")
    .transacted()
    .log("Inserting into database...")
    .to("sql:INSERT INTO orders (id, product, amount) VALUES (2, 'Phone', 500)")
    .log("Sending JMS message...")
    .to("activemq:queue:orders");
Expected Outcome:
The route now supports distributed transactions across PostgreSQL and ActiveMQ.
Troubleshooting:
Ensure ActiveMQ is running and configured in application.properties.
Task 3: Set Up Transaction Rollback and Commit Strategies
Step 1: Simulate a Rollback Scenario
Modify the route to force a rollback:
from("direct:rollbackTest")
    .transacted()
    .log("Attempting transaction...")
    .to("sql:INSERT INTO orders (id, product, amount) VALUES (3, 'Monitor', 200)")
    .throwException(new RuntimeException("Forced rollback"))
    .to("activemq:queue:orders");
Expected Outcome:
The transaction will roll back, and no data will be committed.
Step 2: Verify Transaction Behavior
Check the database to confirm no entry was added for id=3.
